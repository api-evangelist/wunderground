          "name": "Find nearest active PWS stations",
          "request": {
            "name": "Find nearest active PWS stations",
            "description": {
              "content": "Returns a list of nearest active Personal Weather Stations for a given geographic coordinate. Useful for discovering available station IDs before querying observation data.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "location",
                "near"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "geocode",
                  "value": "<string>",
                  "description": "(Required) Latitude and longitude as a comma-separated pair"
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "(Required) Product type to search for (use \"pws\" for Personal Weather Stations)"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Only JSON is currently supported."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
