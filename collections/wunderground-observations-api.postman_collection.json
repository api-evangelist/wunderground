          "name": "Get all observations for the current day",
          "request": {
            "name": "Get all observations for the current day",
            "description": {
              "content": "Returns all rapid-fire observation records for a specified Personal Weather Station for the current day (up to 1 day of data). Useful for tracking real-time conditions throughout the day.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "pws",
                "observations",
                "all",
                "1day"
