  "info": {
    "_postman_id": "8531191f-a189-40ad-96f7-60bf1b5c4dc5",
    "name": "Weather Underground PWS Forecast Observations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for Personal Weather Station (PWS) data provided by Weather Underground (hosted at api.weather.com). Provides current conditions, daily summaries, hourly and daily historical records, 5-day forecasts, and station location lookup. Access requires a free API key issued to registered PWS contributors.\n",
      "type": "text/plain"
    }
  }
